# Teste 1 em dois computadores: CLIENTE da calculadora (computador_1)
#
# Le a operacao e os operandos, envia ao servidor (computador_2) pelo canal
# "requisicao" e imprime o resultado recebido pelo canal "resposta".
# Veja os comentarios de teste1_servidor_calculadora.minipar para rodar.

seq {
    print("==== Calculadora - CLIENTE (computador_1) ====");
    print("Opcoes: +, -, *, /");
    var ip_servidor = input("IP do computador servidor (computador_2): ");

    # O cliente envia para a porta 5101 do servidor e escuta a porta 5102.
    var requisicao = c_channel(ip_servidor, 5101);
    var resposta = c_channel("0.0.0.0", 5102);

    var operacao = input("Operacao (+,-,*,/): ");
    var operando1 = input("Operando 1: ");
    var operando2 = input("Operando 2: ");

    # Confere os operandos aqui mesmo: to_number encerra com erro claro se nao for numero.
    var v1 = to_number(operando1);
    var v2 = to_number(operando2);

    send(requisicao, operacao);
    send(requisicao, operando1);
    send(requisicao, operando2);

    var resultado = receive(resposta);
    print("Resultado:", resultado);
}
